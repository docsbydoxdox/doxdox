{
  "name": "doxdox-cli",
  "description": "CLI package for doxdox.",
  "version": "4.0.0-preview.27",
  "bin": {
    "doxdox": "./dist/src/index.js"
  },
  "exports": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "doxdox-core": "4.0.0-preview.27",
    "doxdox-parser-jsdoc": "4.0.0-preview.27",
    "doxdox-renderer-bootstrap": "4.0.0-preview.27",
    "doxdox-renderer-json": "4.0.0-preview.27",
    "doxdox-renderer-markdown": "4.0.0-preview.27",
    "globby": "16.2.4",
    "import-from": "4.0.0",
    "parse-cmd-args": "5.0.2",
    "update-notifier": "7.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.4.0",
    "@types/update-notifier": "6.0.8",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "eslint": "10.9.1",
    "jest": "30.4.2",
    "nodemon": "3.1.14",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.12",
    "ts-jest-resolver": "2.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  },
  "scripts": {
    "test": "npx cross-env@10.1.0 NODE_OPTIONS=--experimental-vm-modules jest --runInBand --passWithNoTests",
    "test-update": "npx cross-env@10.1.0 NODE_OPTIONS=--experimental-vm-modules jest --runInBand --passWithNoTests --updateSnapshot",
    "build": "rimraf dist/ && tsc && chmod +x ./dist/src/index.js",
    "lint": "eslint"
  },
  "jest": {
    "collectCoverage": true,
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "resolver": "ts-jest-resolver",
    "testRegex": ".*.test.ts$"
  },
  "keywords": [
    "doxdox",
    "documentation",
    "cli"
  ],
  "authors": [
    {
      "name": "Scott Doxey",
      "email": "hello@scottdoxey.com",
      "homepage": "http://scottdoxey.com/"
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/docsbydoxdox/doxdox",
  "repository": {
    "type": "git",
    "url": "git://github.com/docsbydoxdox/doxdox.git"
  }
}
